{% render 'biblesocks-tokens' %}
<style>
  .bs-specs-{{ section.id }}{ display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center; }
  .bs-specs-{{ section.id }} h2{ font-size:clamp(28px,4vw,44px); margin-bottom:24px; }
  .bs-specs-{{ section.id }} .row{ display:flex; justify-content:space-between; padding:18px 0; border-bottom:1px solid var(--bs-hairline); font-family:'Space Mono',monospace; font-size:12.5px; letter-spacing:0.05em; }
  .bs-specs-{{ section.id }} .row .label{ color:var(--bs-stone); }
  .bs-specs-{{ section.id }} .row .val{ color:var(--bs-gold); }
  .bs-specs-{{ section.id }} .visual{ aspect-ratio:4/3; background-size:cover; background-position:center; background-color:#1e1b17; border:1px solid var(--bs-hairline); position:relative; }
  .bs-specs-{{ section.id }} .visual .imglabel{ position:absolute; bottom:16px; left:16px; font-family:'Space Mono',monospace; font-size:10px; color:var(--bs-stone); }
  @media (max-width:900px){ .bs-specs-{{ section.id }}{ grid-template-columns:1fr; } }
</style>

<div class="bs-section" style="padding:96px 0; border-bottom:1px solid var(--bs-hairline);">
  <div class="bs-wrap">
    <div class="bs-specs-{{ section.id }}">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="bs-patch bs-mono">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2>{{ section.settings.headline }}</h2>
        <div class="spec-list">
          {%- for block in section.blocks -%}
            <div class="row" {{ block.shopify_attributes }}><span class="label">{{ block.settings.label }}</span><span class="val">{{ block.settings.value }}</span></div>
          {%- endfor -%}
        </div>
      </div>
      <div class="visual" {% if section.settings.image != blank %}style="background-image:url('{{ section.settings.image | image_url: width: 1000 }}')"{% endif %}>
        {%- if section.settings.image == blank -%}<div class="imglabel bs-mono">IMG PLACEHOLDER — product detail</div>{%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BS: Built to Last",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow tag", "default": "Built to Last" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Made to Be Worn Hard." },
    { "type": "image_picker", "id": "image", "label": "Product detail image" }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Material" },
        { "type": "text", "id": "value", "label": "Value", "default": "Combed Cotton" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "BS: Built to Last",
      "blocks": [
        { "type": "spec", "settings": { "label": "Material", "value": "Combed Cotton" } },
        { "type": "spec", "settings": { "label": "Construction", "value": "Reinforced Heel" } },
        { "type": "spec", "settings": { "label": "Standard", "value": "Wear-Tested" } }
      ]
    }
  ]
}
{% endschema %}
