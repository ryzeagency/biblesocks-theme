{% render 'biblesocks-tokens' %}
<style>
  .bs-bundle-{{ section.id }}{ display:grid; grid-template-columns:1.1fr 1fr; gap:56px; align-items:center; }
  .bs-bundle-{{ section.id }} .visual{ aspect-ratio:5/4; background-size:cover; background-position:center; background-color:#1e1b17; border:1px solid var(--bs-hairline); position:relative; }
  .bs-bundle-{{ section.id }} .visual .imglabel{ position:absolute; bottom:16px; left:16px; font-family:'Space Mono',monospace; font-size:10px; color:var(--bs-stone); max-width:220px; }
  .bs-bundle-{{ section.id }} h2{ font-size:clamp(30px,4.4vw,48px); margin-bottom:18px; }
  .bs-bundle-{{ section.id }} p{ color:var(--bs-cream); opacity:0.85; font-size:17px; margin-bottom:30px; max-width:460px; }
  .bs-bundle-{{ section.id }} .pills{ display:flex; gap:12px; margin-bottom:32px; flex-wrap:wrap; }
  .bs-bundle-{{ section.id }} .pill{ border:1px solid var(--bs-hairline); padding:10px 18px; font-family:'Space Mono',monospace; font-size:11.5px; letter-spacing:0.06em; color:var(--bs-stone); }
  .bs-bundle-{{ section.id }} .pill.active{ border-color:var(--bs-gold); color:var(--bs-gold); }
  @media (max-width:900px){ .bs-bundle-{{ section.id }}{ grid-template-columns:1fr; } }
</style>

<div class="bs-section" style="padding:96px 0; border-bottom:1px solid var(--bs-hairline);">
  <div class="bs-wrap">
    <div class="bs-bundle-{{ section.id }}">
      <div class="visual" {% if section.settings.image != blank %}style="background-image:url('{{ section.settings.image | image_url: width: 1200 }}')"{% endif %}>
        {%- if section.settings.image == blank -%}<div class="imglabel bs-mono">IMG PLACEHOLDER — 3-pack/5-pack gift box, kraft + twine</div>{%- endif -%}
      </div>
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="bs-patch bs-mono">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2>{{ section.settings.headline }}</h2>
        {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
        <div class="pills">
          {%- for block in section.blocks -%}
            <div class="pill {% if block.settings.active %}active{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</div>
          {%- endfor -%}
        </div>
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link }}" class="bs-btn bs-btn-solid">{{ section.settings.cta_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BS: Bundle / Gift Sets",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bundle image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow tag", "default": "Gift Sets" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "One List. One Box. Done." },
    { "type": "textarea", "id": "body", "label": "Body copy", "default": "Build the multi-gift basket — one for every man on your list." },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Build a Gift Set" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "pack_option",
      "name": "Pack option",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "3-Pack" },
        { "type": "checkbox", "id": "active", "label": "Highlighted as default", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "BS: Bundle / Gift Sets",
      "blocks": [
        { "type": "pack_option", "settings": { "label": "3-Pack", "active": false } },
        { "type": "pack_option", "settings": { "label": "5-Pack", "active": true } },
        { "type": "pack_option", "settings": { "label": "Build Your Own", "active": false } }
      ]
    }
  ]
}
{% endschema %}
