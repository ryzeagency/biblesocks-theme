{% render 'biblesocks-tokens' %}

{%- liquid
  assign hero_image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: hero_image
-%}

<style>
  #BSHero-{{ section.id }} {
    position: relative;
    display: flex;
    align-items: center;
    /* Framed to the photo, so the subject sits where the art direction put it.
       The explicit width keeps the height cap from narrowing the section. */
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 560px;
    max-height: 92vh;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--bs-onyx);
  }

  #BSHero-{{ section.id }} .bs-hero-media,
  #BSHero-{{ section.id }} .bs-hero-media img,
  #BSHero-{{ section.id }} .bs-hero-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #BSHero-{{ section.id }} .bs-hero-media {
    z-index: -2;
  }

  #BSHero-{{ section.id }} .bs-hero-media img {
    display: block;
    object-fit: cover;
    object-position: {{ section.settings.image_position | default: 'center center' }};
  }

  #BSHero-{{ section.id }} .bs-hero-placeholder {
    background: repeating-linear-gradient(135deg, #26221d 0 40px, #201d19 40px 80px);
  }

  /* Darkens the side the copy sits on, so it reads over any part of the photo. */
  #BSHero-{{ section.id }}::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(10, 9, 8, {{ section.settings.overlay_opacity | divided_by: 100.0 }}) 0%,
      rgba(10, 9, 8, {{ section.settings.overlay_opacity | divided_by: 200.0 }}) 38%,
      rgba(10, 9, 8, 0) 60%
    );
  }

  #BSHero-{{ section.id }} .bs-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 0 4vw;
  }

  #BSHero-{{ section.id }} .bs-hero-copy {
    max-width: 46vw;
  }

  #BSHero-{{ section.id }} .bs-hero-eyebrow {
    display: inline-block;
    margin-bottom: clamp(14px, 1.6vw, 28px);
    padding: 0.45em 1em;
    border: 2px solid var(--bs-gold);
    color: var(--bs-cream);
    font-family: 'Space Mono', monospace;
    font-size: clamp(12px, 1.2vw, 20px);
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  #BSHero-{{ section.id }} .bs-hero-br {
    display: none;
  }

  #BSHero-{{ section.id }} h1 {
    margin: 0;
    color: var(--bs-cream);
    font-size: clamp(54px, 8.6vw, 156px);
    line-height: 0.9;
    letter-spacing: 0;
  }

  #BSHero-{{ section.id }} .bs-hero-offer {
    margin-top: clamp(8px, 0.8vw, 14px);
    color: var(--bs-gold);
    font-family: 'Anton', 'Arial Narrow', sans-serif;
    font-size: clamp(34px, 5.9vw, 108px);
    line-height: 1;
    text-transform: uppercase;
  }

  #BSHero-{{ section.id }} .bs-hero-sub {
    margin-top: clamp(10px, 1vw, 18px);
    color: var(--bs-cream);
    font-family: 'Space Mono', monospace;
    font-size: clamp(15px, 1.95vw, 32px);
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  #BSHero-{{ section.id }} .bs-hero-cta {
    display: inline-block;
    margin-top: clamp(20px, 2.4vw, 42px);
    padding: 0.78em 1.55em;
    border-radius: 2px;
    background: var(--bs-gold);
    color: #000 !important;
    font-family: 'Anton', 'Arial Narrow', sans-serif;
    font-size: clamp(16px, 2vw, 34px);
    letter-spacing: 0.09em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  #BSHero-{{ section.id }} .bs-hero-cta:hover {
    background: var(--bs-cream);
    transform: translateY(-1px);
  }

  #BSHero-{{ section.id }} .bs-hero-imgnote {
    position: absolute;
    top: 20px;
    left: 20px;
    color: var(--bs-stone);
    font-family: 'Space Mono', monospace;
    font-size: 11px;
  }

  @media screen and (max-width: 749px) {
    #BSHero-{{ section.id }} {
      align-items: flex-start;
      aspect-ratio: 9 / 16;
      min-height: 0;
      max-height: none;
    }

    #BSHero-{{ section.id }}::after {
      background: linear-gradient(
        180deg,
        rgba(10, 9, 8, {{ section.settings.overlay_opacity | divided_by: 100.0 }}) 0%,
        rgba(10, 9, 8, {{ section.settings.overlay_opacity | divided_by: 200.0 }}) 40%,
        rgba(10, 9, 8, 0) 62%
      );
    }

    #BSHero-{{ section.id }} .bs-hero-inner {
      padding: 7vw 7vw 0;
    }

    #BSHero-{{ section.id }} .bs-hero-copy {
      max-width: 62vw;
    }

    #BSHero-{{ section.id }} .bs-hero-eyebrow {
      margin-bottom: 4vw;
      font-size: max(11px, 3vw);
      border-width: 1.5px;
    }

    /* "Sunday best. / Everyday faith." on two lines, as in the mobile art. */
    #BSHero-{{ section.id }} .bs-hero-br {
      display: inline;
    }

    #BSHero-{{ section.id }} h1 {
      font-size: 13.2vw;
    }

    #BSHero-{{ section.id }} .bs-hero-offer {
      margin-top: 4vw;
      font-size: 14vw;
      line-height: 0.95;
    }

    /* "Up to" steps down to a small line above the big "20% off". */
    #BSHero-{{ section.id }} .bs-hero-offer-lead {
      display: block;
      margin-bottom: 1vw;
      font-size: 5.6vw;
      letter-spacing: 0.08em;
    }

    #BSHero-{{ section.id }} .bs-hero-sub {
      /* Monospace, so 14ch breaks "For the man / who shows up." as in the art. */
      max-width: 14ch;
      margin-top: 4vw;
      font-size: 4.4vw;
    }

    #BSHero-{{ section.id }} .bs-hero-cta {
      margin-top: 5vw;
      font-size: 4.2vw;
    }
  }
</style>

<section
  id="BSHero-{{ section.id }}"
  class="bs-section bs-hero"
  {{ section.shopify_attributes }}
>
  <div class="bs-hero-media">
    {%- if hero_image != blank -%}
      <picture>
        {%- if section.settings.mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 600 }} 600w,
              {{ mobile_image | image_url: width: 900 }} 900w,
              {{ mobile_image | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          hero_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: hero_image.alt
        }}
      </picture>
    {%- else -%}
      <div class="bs-hero-placeholder"></div>
      <div class="bs-hero-imgnote">IMG PLACEHOLDER — upload a hero photo in section settings</div>
    {%- endif -%}
  </div>

  <div class="bs-hero-inner">
    <div class="bs-hero-copy">
      {%- if section.settings.eyebrow != blank -%}
        <div class="bs-hero-eyebrow">
          {{- section.settings.eyebrow | escape | replace: '. ', '.<br class="bs-hero-br"> ' -}}
        </div>
      {%- endif -%}

      {%- if section.settings.headline != blank -%}
        <h1>{{ section.settings.headline | escape | newline_to_br }}</h1>
      {%- endif -%}

      {%- if section.settings.offer_lead != blank or section.settings.offer != blank -%}
        <div class="bs-hero-offer">
          {%- if section.settings.offer_lead != blank -%}
            <span class="bs-hero-offer-lead">{{ section.settings.offer_lead | escape }}</span>
          {% endif -%}
          {{- section.settings.offer | escape -}}
        </div>
      {%- endif -%}

      {%- if section.settings.subheadline != blank -%}
        <div class="bs-hero-sub">{{ section.settings.subheadline | escape }}</div>
      {%- endif -%}

      {%- if section.settings.primary_cta_text != blank -%}
        <a
          href="{{ section.settings.primary_cta_link | default: routes.all_products_collection_url }}"
          class="bs-hero-cta"
        >
          {{- section.settings.primary_cta_text | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BS: Hero",
  "tag": "section",
  "class": "bs-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image",
      "info": "Landscape, 16:9. Keep the left side clear for the text."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Portrait, 9:16. Keep the top-left clear for the text. Falls back to the desktop image."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focus",
      "default": "center center",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Middle left" },
        { "value": "center center", "label": "Middle center" },
        { "value": "right center", "label": "Middle right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Shade behind the text",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Tag",
      "default": "Sunday best. Everyday faith.",
      "info": "On mobile it breaks onto a new line after each full stop."
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "Buy more.\nSave more.",
      "info": "Each line of the box is a line of the headline."
    },
    {
      "type": "text",
      "id": "offer_lead",
      "label": "Offer, small part",
      "default": "Up to",
      "info": "Sits on its own smaller line on mobile."
    },
    {
      "type": "text",
      "id": "offer",
      "label": "Offer",
      "default": "20% off"
    },
    {
      "type": "text",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "For the man who shows up."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Button text",
      "default": "Shop & save"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "BS: Hero"
    }
  ]
}
{% endschema %}
