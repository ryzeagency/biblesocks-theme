{% render 'biblesocks-tokens' %}

{%- liquid
  assign hero_image = section.settings.image
-%}

<style>
  #BSHero-{{ section.id }} {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--bs-hairline);
    background-color: var(--bs-onyx);
  }

  #BSHero-{{ section.id }} .bs-hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  #BSHero-{{ section.id }} .bs-hero-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  #BSHero-{{ section.id }} .bs-hero-media::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background: #000;
    background: linear-gradient(180deg, rgba(112, 140, 103, 0) 0%, rgba(0, 0, 0, 1) 100%);
}

  #BSHero-{{ section.id }} .bs-hero-placeholder {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        135deg,
        #26221d 0 40px,
        #201d19 40px 80px
      );
  }

  #BSHero-{{ section.id }}::after {
    display: none;
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(18, 17, 16, 0.15) 0%,
      rgba(18, 17, 16, 0.55) 55%,
      rgba(18, 17, 16, 0.97) 100%
    );
  }

  #BSHero-{{ section.id }} .bs-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 32px 76px;
  }

  #BSHero-{{ section.id }} h1 {
    margin: 0 0 20px;
    font-size: clamp(48px, 8vw, 60px);
  }

  #BSHero-{{ section.id }} h1 .gold {
    color: var(--bs-gold);
  }

  #BSHero-{{ section.id }} .sub {
    max-width: 520px;
    margin: 0 0 36px;
    color: var(--bs-cream);
    font-size: 19px;
    font-style: italic;
    opacity: 0.86;
  }

  #BSHero-{{ section.id }} .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  #BSHero-{{ section.id }} .alt {
    margin-top: 26px;
    color: var(--bs-stone);
    font-family: "Space Mono", monospace;
    font-size: 11px;
  }

  #BSHero-{{ section.id }} .imgnote {
    position: absolute;
    top: 28px;
    left: 32px;
    z-index: 1;
    max-width: 280px;
    color: var(--bs-stone);
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  @media screen and (max-width: 749px) {
    #BSHero-{{ section.id }} {
      min-height: 75vh;
    }

    #BSHero-{{ section.id }} .bs-hero-inner {
      padding: 48px 20px 52px;
    }

    #BSHero-{{ section.id }} .imgnote {
      top: 20px;
      left: 20px;
    }
  }
</style>

<section
  id="BSHero-{{ section.id }}"
  class="bs-section bs-hero"
  {{ section.shopify_attributes }}
>
  <div class="bs-hero-media">
    {%- if hero_image != blank -%}
      {{
        hero_image
        | image_url: width: 2400
        | image_tag:
          class: 'bs-hero-image',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: hero_image.alt
      }}
    {%- else -%}
      <div class="bs-hero-placeholder"></div>
    {%- endif -%}
  </div>

  {%- if hero_image == blank -%}
    <div class="imgnote bs-mono">
      IMG PLACEHOLDER — upload a hero photo in section settings
    </div>
  {%- endif -%}

  <div class="bs-hero-inner">
    {%- if section.settings.eyebrow != blank -%}
      <div class="bs-patch bs-mono">
        {{ section.settings.eyebrow }}
      </div>
    {%- endif -%}

    {%- if section.settings.headline != blank -%}
      <h1>{{ section.settings.headline }}</h1>
    {%- endif -%}

    {%- if section.settings.subheadline != blank -%}
      <p class="sub">
        {{ section.settings.subheadline }}
      </p>
    {%- endif -%}

    <div class="ctas">
      {%- if section.settings.primary_cta_text != blank -%}
        <a
          href="{{ section.settings.primary_cta_link | default: routes.all_products_collection_url }}"
          class="bs-btn bs-btn-solid"
        >
          {{ section.settings.primary_cta_text }}
        </a>
      {%- endif -%}

      {%- if section.settings.secondary_cta_text != blank -%}
        <a
          href="{{ section.settings.secondary_cta_link | default: routes.all_products_collection_url }}"
          class="bs-btn bs-btn-line"
        >
          {{ section.settings.secondary_cta_text }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.alt_headline != blank -%}
      <div class="alt bs-mono">
        {{ section.settings.alt_headline }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BS: Hero",
  "tag": "section",
  "class": "bs-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "center center",
      "options": [
        {
          "value": "left top",
          "label": "Top left"
        },
        {
          "value": "center top",
          "label": "Top center"
        },
        {
          "value": "right top",
          "label": "Top right"
        },
        {
          "value": "left center",
          "label": "Middle left"
        },
        {
          "value": "center center",
          "label": "Middle center"
        },
        {
          "value": "right center",
          "label": "Middle right"
        },
        {
          "value": "left bottom",
          "label": "Bottom left"
        },
        {
          "value": "center bottom",
          "label": "Bottom center"
        },
        {
          "value": "right bottom",
          "label": "Bottom right"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag",
      "default": "Faithwear For Men"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Stand Firm. From the Ground Up."
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Faithwear for men who don't flinch — and the gift he'll actually wear."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary button text",
      "default": "Shop For Him"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary button text",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "alt_headline",
      "label": "Small rotation note (optional)",
      "default": "Alt headline in rotation: \"The First Armor You Put On.\""
    }
  ],
  "presets": [
    {
      "name": "BS: Hero"
    }
  ]
}
{% endschema %}