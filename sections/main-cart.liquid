<div class="page-width page-content">

  {%- render 'breadcrumbs' -%}

  <header class="section-header text-center{% if cart.item_count == 0 %} section-header--404{% endif %}">
    <h1 class="section-header__title">{{ 'cart.general.title' | t }}</h1>
    <div class="rte text-spacing">
      {%- if cart.item_count == 0 -%}
        <p>{{ 'cart.general.empty' | t }}</p>
      {%- endif -%}
      <p>{{ 'cart.general.continue_browsing_html' | t: url: routes.all_products_collection_url }}</p>
    </div>
  </header>

  {%- if cart.item_count > 0 -%}
    {{ 'cart-extras.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'cart-extras.js' | asset_url }}" defer="defer"></script>

    <form action="{{ routes.cart_url }}" method="post" novalidate data-location="page" id="CartPageForm">
      <cart-extras data-section-id="{{ section.id }}" data-cart-url="{{ routes.cart_url }}">
      <div class="cart__page">
        <div data-products class="cart__page-col">
          {% for item in cart.items %}
            {%- render 'cart-item', product: item, sizes: '150px', -%}
          {%- endfor -%}
        </div>
        <div class="cart__page-col">
          <div data-cart-extras-part="summary">
            {%- render 'cart-extras-summary', section: section -%}
          </div>

          {% if settings.cart_notes_enable %}
            <div>
              <label for="CartNote">{{ 'cart.general.note' | t }}</label>
              <textarea name="note" class="input-full cart-notes" id="CartNote">{{ cart.note }}</textarea>
            </div>
          {% endif %}

          <div data-discounts>
            {% if cart.cart_level_discount_applications != blank %}
              <div class="cart__discounts cart__item-sub cart__item-row">
                <div>{{ 'cart.general.discounts' | t }}</div>
                <div class="text-right">
                  {% for cart_discount in cart.cart_level_discount_applications %}
                    <div class="cart__discount">
                      {{ cart_discount.title }} (-{{ cart_discount.total_allocated_amount | money }})
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          </div>

          <div class="cart__item-sub cart__item-row">
            <div>{{ 'cart.general.subtotal' | t }}</div>
            <div data-subtotal>{{ cart.total_price | money }}</div>
          </div>

          {% if settings.cart_terms_conditions_enable %}
            <div class="cart__item-row cart__terms">
              <input type="checkbox" id="CartTerms" class="cart__terms-checkbox">
              <label for="CartTerms">
                {% if settings.cart_terms_conditions_page != blank %}
                  {{ 'cart.general.terms_html' | t: url: settings.cart_terms_conditions_page.url }}
                {% else %}
                  {{ 'cart.general.terms' | t }}
                {% endif %}
              </label>
            </div>
          {% endif %}

          <div class="cart__item-row cart__checkout-wrapper">
            <button type="submit" name="checkout" data-terms-required="{{ settings.cart_terms_conditions_enable }}" class="btn cart__checkout">
              {{ 'cart.general.checkout' | t }}
            </button>

            {% if additional_checkout_buttons and settings.cart_additional_buttons %}
              <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
            {% endif %}
          </div>

          <div class="cart__item-row text-center">
            <small>
              {{ 'cart.general.shipping_at_checkout' | t }}<br />
            </small>
          </div>
        </div>
      </div>

      <div data-cart-extras-part="upsell">
        {%- render 'cart-extras-upsell', section: section -%}
      </div>
      </cart-extras>
    </form>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main-cart.name",
  "settings": [
    {
      "type": "header",
      "content": "Savings"
    },
    {
      "type": "checkbox",
      "id": "show_savings",
      "label": "Show original total and total saved",
      "default": true,
      "info": "Shown above the subtotal when the cart saves anything, from sale prices or discount codes."
    },
    {
      "type": "text",
      "id": "original_total_label",
      "label": "Original total label",
      "default": "Original total"
    },
    {
      "type": "text",
      "id": "saved_label",
      "label": "Total saved label",
      "default": "Total saved"
    },
    {
      "type": "header",
      "content": "Free shipping bar"
    },
    {
      "type": "checkbox",
      "id": "free_shipping_enable",
      "label": "Show free shipping progress",
      "default": true
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold",
      "default": 75,
      "info": "In your store currency, without the symbol. Measured against the cart total after discounts. Must match your shipping rate."
    },
    {
      "type": "text",
      "id": "free_shipping_away_text",
      "label": "Message before free shipping",
      "default": "You're [amount] away from free shipping",
      "info": "[amount] is how much more is needed."
    },
    {
      "type": "text",
      "id": "free_shipping_unlocked_text",
      "label": "Message once free shipping is reached",
      "default": "You've unlocked free shipping!"
    },
    {
      "type": "header",
      "content": "You might also like"
    },
    {
      "type": "checkbox",
      "id": "upsell_enable",
      "label": "Show suggestions",
      "default": true
    },
    {
      "type": "text",
      "id": "upsell_heading",
      "label": "Heading",
      "default": "You might also like"
    },
    {
      "type": "collection",
      "id": "upsell_collection",
      "label": "Suggest socks from",
      "info": "Socks already in the cart and sold-out socks are skipped."
    },
    {
      "type": "range",
      "id": "upsell_limit",
      "label": "Socks to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "upsell_add_text",
      "label": "Add button text",
      "default": "Add"
    }
  ]
}
{% endschema %}
