{%- comment -%}
  The sock bundle pack builder as a section for a page (templates/page.sock-bundle.json).
  Same markup and script as the `sock_bundle` block on the product page, rendered
  with static: true, so it is always the open Product first layout: the picker in
  the left (or right) column and the pack beside it, live on load. Nothing opens it
  from Add to cart and there is no product of its own.

  The settings live on the section, so the snippets read them off `section` as the
  block (as sections/sock-bundle-picker-grid.liquid does).
{%- endcomment -%}

{%- liquid
  case section.settings.picker_width
    when 'small'
      assign picker_width = 'medium-up--two-fifths'
      assign pack_width = 'medium-up--three-fifths'
    when 'large'
      assign picker_width = 'medium-up--three-fifths'
      assign pack_width = 'medium-up--two-fifths'
    else
      assign picker_width = 'medium-up--one-half'
      assign pack_width = 'medium-up--one-half'
  endcase
-%}

{{ 'sock-bundle.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sock-bundle.js' | asset_url }}" defer="defer"></script>

{%- capture picker_column -%}
  <div
    class="grid__item {{ picker_width }} product-single__sticky sock-bundle-gallery-hidden sock-bundle-gallery-hidden-mobile"
    data-sock-bundle-media="{{ section.id }}"
  >
    <div class="sock-bundle-gallery"></div>
    {%- render 'sock-bundle-picker', block: section, section_id: section.id, product: nil, static: true -%}
  </div>
{%- endcapture -%}

<div class="page-content page-content--product sock-bundle-page" id="SockBundlePage-{{ section.id }}">
  <div class="page-width">
    <div class="grid{% if section.settings.picker_position == 'right' %} grid--product-images-right{% endif %}">
      {%- if section.settings.picker_position != 'right' -%}{{ picker_column }}{%- endif -%}

      <div class="grid__item {{ pack_width }}">
        <div class="product-single__meta product-single__meta--product-first sock-bundle-mode">
          <div class="product-block product-block--sock-bundle">
            {%- render 'sock-bundle', block: section, section_id: section.id, product: nil, static: true -%}
          </div>
        </div>
      </div>

      {%- if section.settings.picker_position == 'right' -%}{{ picker_column }}{%- endif -%}
    </div>
  </div>
</div>

