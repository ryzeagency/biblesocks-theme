{%- comment -%}
  BibleSocks shared design tokens.
  Render this once at the top of every biblesocks-*.liquid section:
  {% render 'biblesocks-tokens' %}
  Safe to render multiple times per page — browsers dedupe identical <style>/<link> requests.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  body p {
    font-family: 'Poppins';
    color: #fff !important;
}
.s4com-helpcenter .hcarticlecontent, .s4com-helpcenter .hcarticlecontent p {
  color: #000 !important;
}
body .rte p {
  color: #000 !important;
}
  header#SiteHeader {
    background: #121110;
}

.footer__title {
  color: #fff !important;
}

.site-nav__link {
    color: #fff;
}

.site-nav__link:hover {
    color: #fff;
}

.site-footer {
    background: #121110;
    color: #fff;
}

.site-footer svg {
    fill: #fff;
}
  :root{
    --bs-onyx:#121110;
    --bs-onyx-2:#1c1a17;
    --bs-gold:#FFCF24;
    --bs-gold-dim:#c9a51c;
    --bs-flame:#FF8202;
    --bs-cream:#F5F0E4;
    --bs-stone:#8a8478;
    --bs-stone-dark:#3a362f;
    --bs-hairline: rgba(245,240,228,0.14);
  }
  .bs-section *{ box-sizing:border-box; }
  .bs-section{
    background:var(--bs-onyx);
    color:var(--bs-cream);
    font-family:'Source Serif 4', Georgia, serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  .bs-section a{ color:inherit; text-decoration:none; }
  .bs-section img{ max-width:100%; display:block; }
  .bs-section h1, .bs-section h2, .bs-section h3, .bs-display{
    font-family:'Anton','Arial Narrow',sans-serif;
    text-transform:uppercase;
    letter-spacing:0.01em;
    font-weight:400;
    line-height:1.02;
    color:var(--bs-cream);
    margin:0;
  }
  .bs-mono{
    font-family:'Space Mono', monospace;
    letter-spacing:0.14em;
    text-transform:uppercase;
  }
  .bs-wrap{ max-width:1200px; margin:0 auto; padding:0 32px; }
  @media (max-width:700px){ .bs-wrap{ padding:0 20px; } }

  /* Signature "patch" eyebrow tag — reused across every section */
  .bs-patch{
    display:inline-flex; align-items:center; gap:10px;
    font-size:11px; color:var(--bs-gold);
    border:1px solid var(--bs-gold-dim);
    padding:6px 14px;
    background:repeating-linear-gradient(90deg, transparent 0 7px, rgba(255,207,36,0.35) 7px 8px);
    background-size:100% 1px; background-repeat:no-repeat;
    background-position:top left, bottom left;
    margin-bottom:22px;
  }
  .bs-patch::before{
    content:''; width:6px; height:6px;
    border:1px solid var(--bs-gold-dim); border-radius:50%; flex-shrink:0;
  }

  .bs-btn{
    display:inline-flex; align-items:center; gap:10px;
    font-family:'Space Mono', monospace; font-size:12.5px;
    letter-spacing:0.1em; text-transform:uppercase;
    padding:15px 28px; border:1px solid var(--bs-gold);
    transition:all .15s ease; white-space:nowrap; cursor:pointer;
  }
  .bs-btn-solid{ background:var(--bs-gold); color:var(--bs-onyx); font-weight:700;color: #000 !important;border-radius:5px; }
  .bs-btn-solid:hover{ background:var(--bs-cream); border-color:var(--bs-cream); }
  .bs-btn-line{ background:transparent; color:var(--bs-cream); border-color:var(--bs-stone-dark); }
  .bs-btn-line:hover{ border-color:var(--bs-cream); }
  .bs-btn-flame{ background:var(--bs-flame); color:var(--bs-onyx); border-color:var(--bs-flame); font-weight:700; }
  .bs-btn-flame:hover{ background:var(--bs-gold); border-color:var(--bs-gold); }

  .bs-section-head{ margin-bottom:48px; max-width:720px; }
  .bs-section-head h2{ font-size:clamp(32px,4.2vw,45px); margin-bottom:16px; }
  .bs-section-head p{ color:var(--bs-stone); font-size:16px; max-width:560px; margin:0; }
</style>
