{% comment %}
  One line on where the cart stands on the pair discounts: "2 pairs: 10% off.
  Add 1 more to save 15%." The discounts are Shopify automatic discounts; this
  only describes them, from Theme settings → Cart → Pack savings line. Pairs
  are counted from the "Socks that count" collection, or the whole cart when
  that is empty, so a tie or bow does not count toward a pack.

  Used in the cart drawer and on the cart page, inside their [data-discounts]
  area (snippets/cart-drawer.liquid, sections/main-cart.liquid), which Impulse
  redraws from templates/cart.ajax.liquid after every change.

  Usage:
  {% render 'cart-pack-tier' %}
{% endcomment %}

{%- if settings.cart_tiers != blank and cart.item_count > 0 -%}
  {%- liquid
    assign tier_collection = settings.cart_tiers_collection
    assign pairs = 0
    for item in cart.items
      assign counts = true
      if tier_collection != blank
        assign counts = false
        for item_collection in item.product.collections
          if item_collection.id == tier_collection.id
            assign counts = true
            break
          endif
        endfor
      endif
      if counts
        assign pairs = pairs | plus: item.quantity
      endif
    endfor

    # The best step the cart has reached, and the first one it has not.
    assign reached_pct = 0
    assign next_qty = 0
    assign next_pct = 0
    assign tiers = settings.cart_tiers | split: ','
    for tier in tiers
      assign parts = tier | split: ':'
      assign tier_qty = parts[0] | strip | plus: 0
      assign tier_pct = parts[1] | strip | plus: 0
      if tier_qty > 0
        if pairs >= tier_qty
          assign reached_pct = tier_pct
        elsif next_qty == 0
          assign next_qty = tier_qty
          assign next_pct = tier_pct
        endif
      endif
    endfor

    assign message = ''
    if pairs > 0 and reached_pct > 0
      assign pairs_text = pairs | append: ''
      assign pct_text = reached_pct | append: ''
      assign message = settings.cart_tiers_current_text | replace: '[count]', pairs_text | replace: '[percent]', pct_text
    endif
    if pairs > 0 and next_qty > 0
      assign more_text = next_qty | minus: pairs | append: ''
      assign pct_text = next_pct | append: ''
      assign next_text = settings.cart_tiers_next_text | replace: '[more]', more_text | replace: '[percent]', pct_text
      assign message = message | append: ' ' | append: next_text | strip
    endif
  -%}
  {%- if message != blank -%}
    <div class="cart-pack-tier{% if next_qty == 0 %} cart-pack-tier--top{% endif %}">{{ message | escape }}</div>
  {%- endif -%}
{%- endif -%}
