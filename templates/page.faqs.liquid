<style>
  .page-faqs__verse {
    max-width: 560px;
    margin: 0 auto 40px;
  }

  .page-faqs__content {
    margin-bottom: 30px;
  }

  /* The site sets body p to white for its dark homepage sections; the .rte rule
     brings answers back to black, and this covers the question text too. */
