<style>

  /* Hide the theme's own header/footer so the lander runs edge to edge */
  .shopify-section-group-header-group,
  .shopify-section-group-footer-group { display: none; }

  /* ---------- Tokens ---------- */
  .bs-lp {
    --bs-black:      #000000;
    --bs-charcoal:   #1c1a17;   /* mission + footer */
    --bs-espresso:   #1c150f;   /* testimonials */
    --bs-gold:       #ffcf24;   /* single accent — bands, headings, buttons */
    --bs-gold-deep:  #ecb908;
    --bs-white:      #ffffff;
    --bs-muted:      #e4e0da;
    --bs-rule:       rgba(255,255,255,.34);

    --bs-body:    'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --bs-display: 'Playfair Display', Georgia, 'Times New Roman', serif;

    font-family: var(--bs-body);
    background: var(--bs-black);
    color: var(--bs-white);
    margin: 0;
    width: 100%;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, h4, h5, h6 {
        font-family: var(--bs-body);
    }
  .bs-lp *, .bs-lp *::before, .bs-lp *::after { box-sizing: border-box; }
  .bs-lp img { display: block; max-width: 100%; height: auto; }
  /* :where() keeps this reset at zero specificity so component classes below can
     still set their own margins / text-transform without needing !important */
  .bs-lp :where(h1, h2, h3, p, ul) { margin: 0; }
  .bs-lp :where(ul) { padding: 0; list-style: none; }
  .bs-lp a { text-decoration: none; color: inherit; }
  .bs-lp svg { display: block; }

  .bs-container { width: 77.5vw; margin-inline: auto; }
  .bs-svg-defs { position: absolute; width: 0; height: 0; overflow: hidden; }

  /* Theme overrides: parent theme likes to uppercase headings and repaint links */
  .bs-lp :where(h1, h2, h3) { text-transform: none; font-weight: 800; }
  .bs-lp a.bs-btn, .bs-lp a.bs-btn:visited { text-decoration: none !important; }
  .bs-lp .bs-btn--solid,  .bs-lp .bs-btn--solid:visited  { background: var(--bs-gold) !important; color: #111 !important; }
  .bs-lp .bs-btn--ghost,  .bs-lp .bs-btn--ghost:visited  { color: var(--bs-gold) !important; }

  /* ---------- Reveal animations ---------- */
  .bs-reveal {
    opacity: 0;
    transform: translateY(1.4vw);
    transition: opacity .7s ease, transform .7s ease;
    will-change: opacity, transform;
  }
  .bs-reveal.bs-in { opacity: 1; transform: translateY(0); }
  .bs-reveal[data-delay="1"] { transition-delay: .10s; }
  .bs-reveal[data-delay="2"] { transition-delay: .20s; }
  .bs-reveal[data-delay="3"] { transition-delay: .30s; }
  @media (prefers-reduced-motion: reduce) {
    .bs-reveal { opacity: 1; transform: none; transition: none; }
    .bs-lp * { animation: none !important; transition: none !important; }
  }

  /* ---------- Buttons ---------- */
  .bs-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--bs-body);
    font-weight: 600;
    font-size: 0.9vw;                  /* 20px */
    line-height: 1.1;
    padding: 0.9vw 1.95vw;              /* → 60px tall, matches the comp */
    border-radius: 62vw;
    border: 0.104vw solid transparent;  /* 2px */
    cursor: pointer;
    transition: transform .25s ease, box-shadow .25s ease, background-color .25s ease, color .25s ease;
  }
  .bs-btn:hover { transform: translateY(-0.15vw); box-shadow: 0 0.5vw 1.2vw rgba(0,0,0,.35); }
  .bs-btn:focus-visible { outline: 0.156vw solid var(--bs-gold); outline-offset: 0.2vw; }
  .bs-btn--solid { background: var(--bs-gold); color: #111; }
  .bs-btn--solid:hover { background: var(--bs-gold-deep); }
  .bs-btn--ghost { background: transparent; border-color: var(--bs-gold); color: var(--bs-gold); }
  .bs-btn--ghost:hover { background: rgba(255,207,36,.12); }

  /* ---------- Pill badge ---------- */
  .bs-badge {
    display: inline-flex;
    align-items: center;
    gap: .6em;
    font-size: 1.3vw;                   /* 25px */
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--bs-white);
    padding: 0.48vw 1.93vw;             /* → 49px tall */
    border: 0.083vw solid var(--bs-gold);  /* 1.6px */
    border-radius: 62vw;
  }
  .bs-badge .bs-spark { color: var(--bs-gold); font-size: .9em; }

  /* ---------- Stars + checklist ---------- */
  .bs-stars { display: flex; align-items: center; gap: 0.2vw; color: var(--bs-gold); }
  .bs-stars svg { width: 1.04vw; height: 1.04vw; fill: currentColor; }

  .bs-rating { display: flex; align-items: center; gap: 0.75vw; }
  .bs-rating-text { font-size: 0.97vw; color: var(--bs-muted); }
  .bs-rating-text strong { font-weight: 700; color: var(--bs-white); }

  .bs-checklist { display: flex; flex-direction: column; gap: 1vw; }   /* → 46px row pitch */
  .bs-checklist li { display: flex; align-items: center; gap: 0.85vw; font-size: 1.09vw; line-height: 1.25; }
  .bs-checklist svg { flex: 0 0 auto; width: 1.35vw; height: 1.35vw; color: var(--bs-gold); }
  .bs-checklist .bs-ico-solid { fill: var(--bs-gold); }

  /* ============================================================
     HEADER
  ============================================================ */
  .bs-header { background: var(--bs-black); padding: 2.6vw 0; }
  .bs-logo { display: inline-flex; align-items: center; gap: 1.1vw; }
  .bs-logo-img { height: 5.2vw; width: auto; }
  .bs-logo-mark {
    flex: 0 0 auto;
    width: 5.2vw; height: 5.2vw;      /* 100px */
    border-radius: 50%;
    background: var(--bs-white);
    color: var(--bs-black);
    display: flex; align-items: center; justify-content: center;
  }
  .bs-logo-mark svg { width: 62%; height: 62%; }
  .bs-wordmark {
    font-family: var(--bs-display);
    font-weight: 600;
    font-size: 4.1vw;
    line-height: 1;
    letter-spacing: -.005em;
    color: var(--bs-white);
    text-transform: none;
  }

  /* ============================================================
     HERO — full-bleed photo, content top + bottom
  ============================================================ */
  .bs-hero { position: relative; background: var(--bs-black); overflow: hidden; }
  .bs-hero-media {
    position: absolute; inset: 0;
    background-size: cover;
    background-position: center 28%;
    background-repeat: no-repeat;
  }
  .bs-hero-media::after {
    content: '';
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,.35) 0%, rgba(0,0,0,.05) 18%, rgba(0,0,0,.10) 38%,
                      rgba(0,0,0,.52) 62%, rgba(0,0,0,.78) 82%, rgba(0,0,0,.88) 100%);
  }
  .bs-hero-inner {
    position: relative;
    z-index: 1;
    min-height: 56.9vw;                 /* 1092px */
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 4.75vw 0 3.4vw;
  }

  .bs-hero-top { display: flex; flex-direction: column; align-items: flex-start; gap: 1.05vw; }
  .bs-hero-product {
    display: flex; align-items: baseline; gap: 1.7vw;
    padding-left: 2.15vw;               /* lines up with the badge's inner text */
    font-size: 1.48vw;
    font-weight: 500;
    color: var(--bs-white);
    text-shadow: 0 0.1vw 0.5vw rgba(0,0,0,.55);
  }

  .bs-hero-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5vw;
    align-items: end;
  }
  .bs-hero-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 1.15vw; }
  .bs-hero-title {
    font-size: 3.18vw;                  /* 61px */
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -.01em;
    text-transform: uppercase;
    color: var(--bs-white);
  }
  .bs-hero-title span {
    display: block;
    color: var(--bs-gold);
    font-size: 1.27em;                  /* → ~80px */
    line-height: 1.02;
  }
  .bs-hero-sub { font-size: 1.09vw; line-height: 1.25; color: #eae7e2; max-width: 38vw; }

  .bs-hero-proof { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5vw; }
  .bs-hero-actions { display: flex; flex-wrap: wrap; gap: 1.45vw; margin-top: 0.4vw; }

  /* ============================================================
     CREATOR BAND (gold)
  ============================================================ */
  .bs-creator { background: var(--bs-gold); color: #111; padding: 4.48vw 0 5.94vw; }
  .bs-creator .bs-container {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 19.5vw;
    gap: 4.3vw;
    align-items: center;
  }
  .bs-creator-copy { display: flex; flex-direction: column; align-items: stretch; text-align: center; }
  .bs-creator-copy p.bs-creator-eyebrow { font-size: 1.29vw; font-weight: 500; line-height: 1.3; }
  .bs-bar {
    background: var(--bs-black);
    margin-top: 1.15vw;
    margin-bottom: 1.15vw;
    padding: 1.25vw 1.6vw;
    font-size: 3.11vw;                  /* 60px */
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -.01em;
    text-transform: uppercase;
    color: var(--bs-white);
  }
  .bs-bar span { color: var(--bs-gold); font-weight: 500; }
  .bs-creator-p {
    font-size: 1.08vw;
    line-height: 1.25;
    font-style: italic;
    font-weight: 500;
    max-width: 53.7vw;
    margin-inline: auto;
  }
  .bs-creator-p:first-of-type { margin-top: 1.93vw; }
  .bs-creator-p + .bs-creator-p { margin-top: 1.35vw; }
  .bs-avatar {
    width: 16.7vw; height: 16.7vw;
    justify-self: center;
    border-radius: 50%;
    object-fit: cover;
    background: #e8e8e8;
  }

  /* ============================================================
     SOCK OF THE MONTH (black)
  ============================================================ */
  .bs-sotm { background: var(--bs-black); padding: 4.6vw 0 0; }
  .bs-sotm .bs-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4.4vw;
    align-items: stretch;
  }

  .bs-card {
    display: flex;
    flex-direction: column;
    border-radius: 0.85vw;
    overflow: hidden;
    background: var(--bs-gold);
    transition: transform .35s ease, box-shadow .35s ease;
  }
  .bs-card:hover { transform: translateY(-0.28vw); box-shadow: 0 1.3vw 2.8vw rgba(0,0,0,.55); }
  .bs-card img {
    width: 100%;
    aspect-ratio: 709 / 643;
    object-fit: cover;
    object-position: center;
  }
  .bs-card-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5vw;
    background: var(--bs-gold);
    color: #111;
    padding: 1.98vw 2.55vw;             /* → 110px tall bar */
    margin-top: -1px;                   /* kills the sub-pixel seam */
  }
  .bs-card-name  { font-size: 1.49vw; font-weight: 700; }
  .bs-card-price { font-size: 1.49vw; font-weight: 600; white-space: nowrap; }

  .bs-sotm-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;      /* tops + bottoms align with the card */
    padding-bottom: 0.2vw;
  }
  .bs-sotm-badge {
    width: 100%;
    max-width: 30vw;
    justify-content: flex-start;
    padding-left: 1.7vw;
  }
  .bs-sotm-lead { margin-top: 2.5vw; }
  .bs-sotm-title {
    font-size: 5.54vw;                   /* 106px */
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.01em;
    text-transform: uppercase;
    color: var(--bs-gold);
  }
  .bs-sotm-sub { font-size: 1.1vw; line-height: 1.25; color: #f0ede9; margin-top: 0.5vw; }
  .bs-sotm-actions { display: flex; flex-wrap: wrap; gap: 1.05vw; }

  /* ============================================================
     FEATURES BAND (black)
  ============================================================ */
  .bs-features { background: var(--bs-black); padding: 6vw 0 2.3vw; }
  .bs-features .bs-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.6vw;
  }
  .bs-feature { display: flex; align-items: center; gap: 1vw; color: var(--bs-white); }
  .bs-feature img {
    width: 5.2vw; height: 5.2vw;      /* 100px */
    object-fit: contain;
    flex: 0 0 auto;
    filter: brightness(0) invert(1);     /* forces the dark source PNGs to white */
  }
  .bs-feature-title { font-size: 1vw; font-weight: 700; line-height: 1.2; }
  .bs-feature-sub   { font-size: 0.71vw; font-weight: 500; line-height: 1.35; margin-top: 0.2vw; color: #ddd8d1; }
  .bs-feature--caps .bs-feature-title,
  .bs-feature--caps .bs-feature-sub { text-transform: uppercase; }

  /* ============================================================
     MISSION (charcoal)
  ============================================================ */
  .bs-mission { background: var(--bs-charcoal); padding: 3.5vw 0 4vw; text-align: center; }
  .bs-mission .bs-container { display: flex; flex-direction: column; align-items: center; }
  .bs-mission p.bs-mission-eyebrow {
    font-size: 1.04vw;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #f2efeb;
  }
  .bs-mission-title {
    font-size: 3.18vw;                   /* 61px */
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -.01em;
    text-transform: uppercase;
    margin-top: 0.73vw;
  }
  .bs-mission-title span { color: var(--bs-gold); font-size: 1.05em; }
  .bs-mission-p {
    font-size: 1.09vw;
    line-height: 1.25;
    font-style: italic;
    font-weight: 500;
    color: #d9d4cd;
    max-width: 62vw;
    margin-top: 1.9vw;
  }
  .bs-mission-kicker { font-weight: 700; color: var(--bs-white); margin-top: 1.15vw; }

  /* ============================================================
     TESTIMONIALS (espresso)
  ============================================================ */
  .bs-testi { background: var(--bs-espresso); border-top: 1px solid var(--bs-rule); padding: 2.7vw 0 3.2vw; }
  .bs-testi-title {
    font-size: 2.16vw;                   /* 41px */
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -.01em;
    text-transform: uppercase;
    text-align: center;
    margin-bottom: 2.71vw;
  }
  .bs-swiper { position: relative; overflow: hidden; }
  .bs-slide { position: relative; border-radius: 0.62vw; overflow: hidden; background: #141414; }
  .bs-slide video, .bs-slide img {
    width: 100%;
    aspect-ratio: 347 / 624;
    object-fit: cover;
  }
  .bs-handle {
    position: absolute;
    top: 0.6vw; left: 0.6vw;
    z-index: 2;
    display: none; 
    max-width: calc(100% - 1.2vw);
    padding: 0.3vw 0.55vw;
    border-radius: 0.3vw;
    background: rgba(0,0,0,.55);
    backdrop-filter: blur(2px);
    color: var(--bs-white);
    font-size: 0.7vw;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: .01em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bs-testi-foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2vw;
    margin-top: 2.8vw;
  }
  .bs-testi-foot p { font-size: 1.09vw; line-height: 1.25; color: #ece8e2; max-width: 29.5vw; }
  .bs-testi-foot p strong { font-weight: 700; color: var(--bs-white); }
  .bs-testi-foot .bs-btn { justify-self: center; }

  /* ============================================================
     FOOTER
  ============================================================ */
  .bs-footer {
    background: var(--bs-charcoal);
    border-top: 1px solid var(--bs-rule);
    text-align: center;
    padding: 1.82vw 0 3.44vw;
  }
  .bs-footer-name { font-size: 0.9vw; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .bs-footer-copy { font-size: 1.1vw; font-weight: 600; color: var(--bs-muted); margin-top: 0.6vw; }

  /* ============================================================
     MOBILE (≤767px) — desktop & tablet share the vw scale above
  ============================================================ */
  @media (max-width: 767px) {
    .bs-container { width: 90%; }

    .bs-btn { font-size: 15px; padding: 15px 24px; border-width: 2px; border-radius: 999px; }
    .bs-btn:focus-visible { outline-width: 2px; outline-offset: 2px; }
    .bs-badge { font-size: 12px; padding: 10px 18px; border-width: 1.5px; border-radius: 999px; letter-spacing: .08em; }
    .bs-reveal { transform: translateY(22px); }

    .bs-stars svg { width: 15px; height: 15px; }
    .bs-stars { gap: 3px; }
    .bs-rating { gap: 10px; flex-wrap: wrap; }
    .bs-rating-text { font-size: 12px; }
    .bs-checklist { gap: 13px; }
    .bs-checklist li { font-size: 15px; gap: 10px; line-height: 1.35; }
    .bs-checklist svg { width: 19px; height: 19px; }

    /* Header */
    .bs-header { padding: 18px 0; }
    .bs-logo { gap: 10px; }
    .bs-logo-img { height: 44px; }
    .bs-logo-mark { width: 42px; height: 42px; }
    .bs-wordmark { font-size: 32px; }

    /* Hero */
    .bs-hero-media { background-position: 58% 22%; }
    .bs-hero-media::after {
      background: linear-gradient(180deg, rgba(0,0,0,.45) 0%, rgba(0,0,0,.15) 20%,
                  rgba(0,0,0,.55) 48%, rgba(0,0,0,.86) 72%, rgba(0,0,0,.94) 100%);
    }
    .bs-hero-inner { min-height: 620px; padding: 75vw 0 36px; }
    .bs-hero-top { gap: 12px; }
    .bs-hero-product { font-size: 16px; gap: 14px; padding-left: 16px; }
    .bs-hero-bottom { grid-template-columns: 1fr; gap: 28px; }
    .bs-hero-copy { gap: 16px; }
    .bs-hero-title { font-size: 32px; }
    .bs-hero-title span { font-size: 1.2em; }
    .bs-hero-sub { font-size: 15px; max-width: 100%; line-height: 1.45; }
    .bs-hero-proof { gap: 20px; width: 100%; }
    .bs-hero-actions { flex-direction: column; gap: 12px; width: 100%; margin-top: 0; }
    .bs-hero-actions .bs-btn { width: 100%; }

    /* Creator band */
    .bs-creator { padding: 40px 0 44px; }
    .bs-creator .bs-container { grid-template-columns: 1fr; gap: 26px; }
    .bs-creator-copy { order: 2; }
    .bs-avatar { order: 1; width: 130px; height: 130px; }
    .bs-creator .bs-creator-eyebrow { font-size: 15px !important; }
    .bs-bar { margin-top: 12px; padding: 14px 14px; font-size: 26px; }
    .bs-creator-p { font-size: 15px; max-width: 100%; line-height: 1.45; }
    .bs-creator-p:first-of-type { margin-top: 18px; }
    .bs-creator-p + .bs-creator-p { margin-top: 14px; }

    /* Sock of the month */
    .bs-sotm { padding: 44px 0 0; }
    .bs-sotm .bs-container { grid-template-columns: 1fr; gap: 30px; }
    .bs-card { border-radius: 12px; }
    .bs-card-bar { padding: 18px 18px; gap: 12px; }
    .bs-card-name, .bs-card-price { font-size: 17px; }
    .bs-sotm-copy { padding-bottom: 0; }
    .bs-sotm-badge { max-width: 100%; padding-left: 20px; }
    .bs-sotm-lead { margin-top: 18px; }
    .bs-sotm-title { font-size: 44px; }
    .bs-sotm-sub { font-size: 15px; margin-top: 12px; line-height: 1.45; }
    .bs-sotm-copy > * + * { margin-top: 20px; }
    .bs-sotm-actions { flex-direction: column; gap: 12px; width: 100%; }
    .bs-sotm-actions .bs-btn { width: 100%; }

    /* Features */
    .bs-features { padding: 40px 0 32px; }
    .bs-features .bs-container { grid-template-columns: 1fr 1fr; gap: 22px 14px; }
    .bs-feature { gap: 10px; }
    .bs-feature img { width: 46px; height: 46px; }
    .bs-feature-title { font-size: 12px; }
    .bs-feature-sub { font-size: 10px; }

    /* Mission */
    .bs-mission { padding: 44px 0 48px; }
    .bs-mission-eyebrow { font-size: 12px; }
    .bs-mission-title { font-size: 27px; margin-top: 14px; }
    .bs-mission-p { font-size: 15px; max-width: 100%; margin-top: 16px; line-height: 1.45; }
    .bs-mission-kicker { margin-top: 16px; }

    /* Testimonials */
    .bs-testi { padding: 44px 0 40px; }
    .bs-testi-title { font-size: 24px; margin-bottom: 24px; }
    .bs-slide { border-radius: 10px; }
    .bs-handle { top: 8px; left: 8px; padding: 5px 8px; border-radius: 5px; font-size: 11px; max-width: calc(100% - 16px); }
    .bs-testi-foot { grid-template-columns: 1fr; gap: 22px; margin-top: 28px; text-align: center; }
    .bs-testi-foot p { font-size: 15px; max-width: 100%; line-height: 1.45; }
    .bs-testi-foot .bs-btn { justify-self: stretch; }

    /* Footer */
    .bs-footer { padding: 30px 0 32px; }
    .bs-footer-name { font-size: 13px; }
    .bs-footer-copy { font-size: 13px; margin-top: 8px; }
  }
