<script>
  (function () {
    /* ---------- Scroll reveal (subtle fade-up) ---------- */
    var reveals = document.querySelectorAll('.bs-reveal');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('bs-in');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -5% 0px' });
      reveals.forEach(function (el) { io.observe(el); });
    } else {
      reveals.forEach(function (el) { el.classList.add('bs-in'); });
    }

    /* ---------- Testimonial slider: 4 up, loop, autoplay ---------- */
    var swiperEl = document.querySelector('.bs-swiper');
    if (swiperEl && window.Swiper) {
      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      /* 35px gap at the 1920px reference = 1.82vw, kept proportional like the CSS */
      var gap = Math.round(window.innerWidth * 0.0182);
      new Swiper(swiperEl, {
        loop: true,
        speed: 600,
        autoplay: reduceMotion ? false : {
          delay: 3000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        },
        slidesPerView: 1.15,
        spaceBetween: 12,
        breakpoints: {
          768: { slidesPerView: 4, spaceBetween: gap }
        }
      });
    }

    /* ---------- Play videos in view, pause off-screen ----------
       (queried after Swiper init so loop-mode duplicates are included) */
    var vids = document.querySelectorAll('.bs-swiper video');
    if ('IntersectionObserver' in window && vids.length) {
      var vio = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          var v = entry.target;
          if (entry.isIntersecting) {
            var p = v.play();
            if (p && p.catch) { p.catch(function () {}); }
          } else {
            v.pause();
          }
        });
      }, { threshold: 0.35 });
      vids.forEach(function (v) { vio.observe(v); });
    }
  })();
</script>
